# 학원 서버 Next.js 화면. 공개 주소(ngrok)는 이 컨테이너가 받고, API는 같은 주소의 /backend 로 FastAPI에 넘긴다 (next.config.ts rewrites).
# NEXT_PUBLIC_* 값은 빌드할 때 화면 코드에 들어가므로 공개 주소가 바뀌면 다시 빌드한다.
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG NEXT_PUBLIC_API_URL
ARG API_INTERNAL_URL=http://api:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    API_INTERNAL_URL=$API_INTERNAL_URL \
    NEXT_IMAGE_UNOPTIMIZED=1 \
    NEXT_TELEMETRY_DISABLED=1
RUN test -n "$NEXT_PUBLIC_API_URL" && npm run build

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app ./
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000", "-H", "0.0.0.0"]
