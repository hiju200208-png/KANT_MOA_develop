# Use the same password as root .env; URL-encode reserved characters.
DATABASE_URL=postgresql+asyncpg://kantmoa:CHANGE_ME@localhost:5432/kantmoa
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET=생성된값
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_ISSUER=kant-moa
# Google 웹 OAuth 클라이언트 ID. 비워두면 Google 로그인만 비활성화합니다.
GOOGLE_CLIENT_ID=
# 공용 HTTPS에서는 true, localhost HTTP 개발에서만 false를 사용합니다.
GOOGLE_COOKIE_SECURE=true
# Do not put secrets or user documents in static/uploads directories.
