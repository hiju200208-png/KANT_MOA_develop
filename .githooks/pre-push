#!/bin/sh
# [팀 공통 hook] push 전: main 직접 push를 막고, 바뀐 쪽(백엔드·프론트)을 CI와 같은 조건으로 검사한다
# 설치(clone마다 한 번): git config core.hooksPath .githooks

root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
changed=""

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "push 멈춤: main에는 직접 push할 수 없어요. 내 브랜치에 push하고 PR을 만드세요."
    exit 1
  fi
  [ "$local_sha" = "$zero" ] && continue  # 브랜치 삭제는 검사하지 않는다
  # main과 갈라진 지점부터 이번에 올릴 커밋까지 바뀐 파일
  base=$(git merge-base origin/main "$local_sha" 2>/dev/null || echo "")
  if [ -n "$base" ]; then
    changed="$changed
$(git diff --name-only "$base" "$local_sha")"
  fi
done

if echo "$changed" | grep -q '^backend/'; then
  echo "백엔드 변경 있음 → CI와 같은 조건으로 검사해요 (Docker 필요, 1분 정도)"
  (cd "$root/backend" && uv run python scripts/check.py) || exit 1
fi

if echo "$changed" | grep -qE '^(src/|tests/|public/|package(-lock)?\.json$|tsconfig\.json$|eslint\.config\.mjs$|next\.config\.ts$)'; then
  echo "프론트 변경 있음 → npm run lint · typecheck · test"
  if [ ! -d "$root/node_modules" ]; then
    echo "push 멈춤: node_modules가 없어요. 루트에서 npm ci를 먼저 실행하세요."
    exit 1
  fi
  (cd "$root" && npm run lint && npm run typecheck && npm test) || exit 1
fi

exit 0
